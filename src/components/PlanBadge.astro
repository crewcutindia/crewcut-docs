---
interface Props {
  plan: 'Free' | 'Starter' | 'Plus' | 'Studio';
  storage?: string;
  price?: string;
}

const { plan, storage, price } = Astro.props;

const planDetails: Record<string, { label: string; tag: string }> = {
  Free: { label: 'FREE', tag: '2 GB' },
  Starter: { label: 'STARTER', tag: '₹199' },
  Plus: { label: 'PLUS', tag: '₹499' },
  Studio: { label: 'STUDIO', tag: '₹999' },
};

const current = planDetails[plan] || { label: plan, tag: '' };
---

<span class="plan-badge not-content">
  <strong class="plan-label">{current.label}</strong>
  <span class="plan-tag">{price || storage || current.tag}</span>
</span>

<style>
  .plan-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    background: #18181b;
    border: 1px solid #3f3f46;
    font-size: 0.75rem;
    font-family: var(--sl-font-mono, monospace);
    vertical-align: middle;
    margin: 0 0.25rem;
  }
  .plan-label {
    color: #ffffff;
    font-weight: 700;
  }
  .plan-tag {
    color: #a1a1aa;
    font-weight: 500;
  }
</style>
